# ============================================================================
# SGSI UPTex — Variables de entorno (Docker Compose de 2 contenedores)
# Copiar a .env y ajustar antes de `docker compose up -d --build`.
# ============================================================================

# --- Aplicación ---
APP_NAME="SGSI UPTex"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# --- Base de datos (el host SIEMPRE es el nombre del servicio Docker) ---
DB_DATABASE=sgsi_uptex
DB_USERNAME=sgsi_app
# Contraseña del usuario de aplicación — generar una fuerte, nunca dejar vacía:
#   openssl rand -base64 24
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_SEGURA
# Contraseña root de MySQL, solo para administración/inicialización:
DB_ROOT_PASSWORD=CAMBIAR_ESTA_CONTRASENA_ROOT
# Puerto expuesto al host para administración puntual (mysql client, DBeaver...)
DB_EXPOSED_PORT=3306
# --- TLS para bases MySQL externas como TiDB Cloud ---
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# --- Correo (sin Mailpit: log en desarrollo, SMTP real en producción) ---
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sgsi@uptex.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

# --- Usuario administrador inicial (usado por scripts/create-admin.sh) ---
ADMIN_NOMBRE="Administrador SGSI"
ADMIN_EMAIL=admin@uptex.edu.mx
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA_ADMIN
