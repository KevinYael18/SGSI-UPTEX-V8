# ============================================================================
# SGSI UPTex — Variables de entorno (Docker Compose de 2 contenedores)
# Copiar a .env y ajustar antes de `docker compose up -d --build`.
# ============================================================================

# --- Aplicación ---
APP_NAME="SGSI UPTex"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# --- Base de datos (el host SIEMPRE es el nombre del servicio Docker) ---
DB_DATABASE=sgsi_uptex
DB_USERNAME=sgsi_app
# Contraseña del usuario de aplicación — generar una fuerte, nunca dejar vacía:
#   openssl rand -base64 24
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_SEGURA
# Contraseña root de MySQL, solo para administración/inicialización:
DB_ROOT_PASSWORD=CAMBIAR_ESTA_CONTRASENA_ROOT
# Puerto expuesto al host para administración puntual (mysql client, DBeaver...)
DB_EXPOSED_PORT=3306
# --- TLS para bases MySQL externas como TiDB Cloud ---
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# --- Correo (recuperación de contraseña y notificaciones) -------------------
# IMPORTANTE: una red Wi-Fi NO envía correos. Laravel necesita un servidor SMTP
# accesible desde el contenedor. Valores que lee config/mail.php:
#
# A) DESARROLLO con Mailpit (bandeja de pruebas en http://localhost:8025):
#      docker compose --profile mail-dev up -d
#    MAIL_MAILER=smtp  MAIL_HOST=mailpit  MAIL_PORT=1025  MAIL_ENCRYPTION=null
#    (sin usuario ni contraseña; los correos NO salen a Internet)
#
# B) PRODUCCIÓN con SMTP real (cuenta institucional, Google Workspace,
#    Microsoft 365, SendGrid, Amazon SES, etc.):
#    MAIL_MAILER=smtp
#    MAIL_HOST=smtp.proveedor.com
#    MAIL_PORT=587             (587 = STARTTLS  |  465 = SSL/TLS implícito)
#    MAIL_ENCRYPTION=tls       (tls con 587  |  ssl con 465)
#    MAIL_USERNAME=cuenta@dominio
#    MAIL_PASSWORD=contraseña de aplicación (NUNCA la subas a GitHub)
#    MAIL_FROM_ADDRESS debe ser una dirección que el proveedor permita usar
#    como remitente (normalmente la misma cuenta o su dominio verificado).
#
# MAIL_MAILER=log solo escribe el correo en storage/logs/laravel.log: NO lo entrega.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sgsi@uptex.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"
# Opcionales: segundos de espera SMTP y nombre EHLO (dominio público del servidor).
MAIL_TIMEOUT=15
MAIL_EHLO_DOMAIN=
# Puerto local de la bandeja web de Mailpit (solo perfil mail-dev).
MAILPIT_UI_PORT=8025

# --- Recuperación de contraseña ---
# APP_URL (arriba) DEBE ser la dirección con la que los usuarios abren el
# sistema: el enlace del correo se construye con ella. Ejemplos:
#   red Wi-Fi local: APP_URL=http://192.168.1.50:8080
#   Internet:        APP_URL=https://sgsi.tudominio.mx
# Vigencia del enlace (minutos) y espera mínima entre correos por cuenta (segundos).
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

# --- Datos institucionales del pie de los correos ---
INSTITUCION_NOMBRE="Universidad Politécnica de Texcoco"
# Sitio web OFICIAL (opcional; si queda vacío no se muestra en el correo).
INSTITUCION_SITIO_WEB=

# --- Usuario administrador inicial (usado por scripts/create-admin.sh) ---
ADMIN_NOMBRE="Administrador SGSI"
ADMIN_EMAIL=admin@uptex.edu.mx
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA_ADMIN

# --- Acceso por red / servidor (login SPA con cookie de Sanctum) ---
# Incluye TODAS las direcciones (host:puerto) con las que se abrirá el sistema.
# Si un equipo de la red entra por http://192.168.1.50:8080 y esa dirección no
# está aquí, el inicio de sesión fallará (la cookie no se considera de la SPA).
#   Local:      localhost:8080,127.0.0.1:8080
#   Red Wi-Fi:  localhost:8080,192.168.1.50:8080
#   Servidor:   sgsi.tudominio.mx
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# Normalmente vacío (null). Solo si usas subdominios: .tudominio.mx
SESSION_DOMAIN=

# --- Inventario tecnológico ---
# Días tras los cuales un antivirus sin actualizar se considera desactualizado.
INVENTARIO_DIAS_ANTIVIRUS=7
# Límites de la importación de computadoras (KB y filas por archivo).
INVENTARIO_IMPORTACION_MAX_KB=4096
INVENTARIO_IMPORTACION_MAX_FILAS=1000

# SGSI Intelligence Assistant (proveedor interno: Google Gemini).
# La clave se obtiene en Google AI Studio y vive SOLO en el servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modelos de respaldo (coma) si el principal está saturado (503/429) o no responde.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Clasificador ligero para solicitudes ambiguas y embeddings de la base de conocimiento.
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT=25
GEMINI_THINKING_LEVEL=low
# Presupuesto diario de tokens (por usuario y total) y límites de uso.
IA_TOKENS_DIARIOS_USUARIO=150000
IA_TOKENS_DIARIOS_GLOBAL=2000000
IA_MAX_CARACTERES_MENSAJE=2000
# true = lo ambiguo lo decide el clasificador ligero; false = se rechaza (más estricto).
IA_CLASIFICADOR_LLM=true
